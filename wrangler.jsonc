{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superposition-rc1-staging",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./.staging-dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker.js",
  "routes": [
    {
      "pattern": "kaisabuhussein.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kaisabuhussein.com",
      "custom_domain": true
    }
  ]
}
